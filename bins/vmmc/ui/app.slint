// vmmc's window: the library on the left, the open VMs as tabs on the right. A tab
// shows its VM's summary, or its screen while it runs.

import { Button, LineEdit, ComboBox, SpinBox, CheckBox, ScrollView, TextEdit, AboutSlint, ListView } from "std-widgets.slint";

export struct VmRow {
    path: string,
    name: string,
    folder: string,
    // A Windows guest (vmmc Tools are for Windows so far).
    windows: bool,
    // The folder's heading, on the first VM of each folder.
    heading: string,
    os: string,
    running: bool,
    // One line: "4 vCPUs, 8 GiB, NVMe 64 GiB".
    summary: string,
    // The hardware, a line per device.
    details: string,
    notes: string,
    created: string,
    started: string,
    // Where an imported VM came from, or empty.
    origin: string,
}

export struct TabRow {
    path: string,
    name: string,
    running: bool,
}

component ToolButton inherits Button {
    height: 30px;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: 140px;
        vertical-alignment: center;
        color: #c8c8c8;
    }
    @children
}

component Sheet inherits Rectangle {
    // A modal panel over the window.
    in property <string> heading;
    background: #000000a0;
    TouchArea { }
    Rectangle {
        width: min(parent.width - 40px, 620px);
        height: min(parent.height - 40px, 640px);
        background: #2b2b2b;
        border-radius: 8px;
        border-width: 1px;
        border-color: #444;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text {
                text: root.heading;
                font-size: 18px;
                font-weight: 700;
                color: white;
            }
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "vmmc";
    preferred-width: 1280px;
    preferred-height: 820px;
    background: #1e1e1e;
    default-font-size: 13px;

    // The library and the open tabs.
    in property <[VmRow]> vms;
    in property <[TabRow]> tabs;
    in-out property <int> current-tab: -1;
    // The current tab's VM (meaningful while current-tab >= 0).
    in property <VmRow> current;
    in property <string> status-text;

    // The current tab's console, while its VM runs.
    in property <bool> console-live;
    in-out property <bool> show-console: true;
    in property <image> screen;
    in property <int> frame-width: 1;
    in property <int> frame-height: 1;
    in property <image> cursor-image;
    in property <bool> cursor-hardware;
    in property <bool> cursor-shown;
    in property <int> cursor-hot-x;
    in property <int> cursor-hot-y;
    in-out property <bool> keyboard-captured;
    in-out property <bool> fullscreen;
    in-out property <bool> fullscreen-bar;
    in-out property <bool> fit-guest: true;
    in-out property <bool> left;
    in-out property <bool> right;
    in-out property <bool> middle;
    // The console's size changed (for fitting the guest to it).
    // The console's place in the window (logical pixels), and its size.
    callback console-resized(length, length, length, length);

    callback open-vm(string);
    callback select-tab(int);
    callback close-tab(int);
    callback start-vm();
    callback power-button();
    callback stop-vm();
    callback reset-vm();
    callback ctrl-alt-del();
    callback install-tools();
    callback toggle-fullscreen();
    callback pointer(length, length, length, length, bool, bool, bool, int);
    callback save-notes(string);
    callback remove-vm();
    callback move-to-folder(string);
    callback show-folder();
    callback open-settings();
    callback new-vm();
    callback import-vm();

    // The New VM wizard.
    in-out property <bool> wizard-open;
    in-out property <string> wizard-name;
    in-out property <int> wizard-os;
    in property <[string]> os-labels;
    in-out property <string> wizard-iso;
    in-out property <bool> wizard-easy;
    in-out property <string> wizard-user;
    in-out property <string> wizard-password;
    in-out property <int> wizard-edition;
    in property <[string]> editions;
    in-out property <int> wizard-cpus;
    in-out property <int> wizard-memory-gib;
    in-out property <int> wizard-disk-gib;
    in-out property <string> wizard-folder;
    in property <string> wizard-error;
    callback wizard-os-changed(int);
    callback browse-iso();
    callback browse-folder();
    callback create-vm();

    // The settings of the current VM.
    in-out property <bool> settings-open;
    in-out property <int> settings-cpus;
    in-out property <int> settings-memory-mib;
    in-out property <string> settings-cdrom;
    in-out property <string> settings-resolution;
    in-out property <bool> settings-secure-boot;
    in-out property <bool> settings-tpm;
    in-out property <bool> settings-enlightenments;
    in property <string> settings-error;
    callback browse-cdrom();
    callback save-settings();

    // A message, with OK.
    in-out property <bool> message-open;
    in property <string> message-title;
    in property <string> message-text;

    // The window's shortcuts: Ctrl+Alt+Enter toggles full screen (as in VMware), Esc
    // leaves it. They reach the window once Ctrl+Alt has released the keyboard.
    shortcuts := FocusScope {
        width: root.width;
        height: root.height;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.modifiers.control && event.modifiers.alt && event.text == Key.Return && root.current.running) {
                root.toggle-fullscreen();
                return accept;
            }
            if (root.fullscreen && event.text == Key.Escape) {
                root.toggle-fullscreen();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            HorizontalLayout {
                // The library.
                if !root.fullscreen: Rectangle {
                    width: 270px;
                    background: #252526;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: "vmmc";
                            font-size: 20px;
                            font-weight: 700;
                            color: white;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "New VM";
                                clicked => { root.new-vm(); }
                            }
                            Button {
                                text: "Import VMware VM";
                                clicked => { root.import-vm(); }
                            }
                        }
                        ListView {
                            for vm in root.vms: VerticalLayout {
                                if vm.heading != "": Text {
                                    text: vm.heading;
                                    color: #79c0ff;
                                    font-size: 11px;
                                    font-weight: 700;
                                    height: 24px;
                                    vertical-alignment: bottom;
                                }
                                Rectangle {
                                height: 52px;
                                background: area.has-hover ? #2f2f33 : transparent;
                                border-radius: 4px;
                                area := TouchArea {
                                    clicked => { root.open-vm(vm.path); }
                                }
                                HorizontalLayout {
                                    padding: 6px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: vm.running ? #3fb950 : #5a5a5a;
                                    }
                                    VerticalLayout {
                                        Text {
                                            text: vm.name;
                                            color: white;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: vm.os;
                                            color: #9a9a9a;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }
                                }
                            }
                        }
                        Text {
                            text: root.status-text;
                            color: #8a8a8a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Button {
                            text: "About vmmc";
                            clicked => { about.show(); }
                        }
                    }
                }

                VerticalLayout {
                    // The tabs.
                    if !root.fullscreen && root.tabs.length > 0: Rectangle {
                        height: 36px;
                        background: #252526;
                        HorizontalLayout {
                            alignment: start;
                            for tab[index] in root.tabs: Rectangle {
                                width: 190px;
                                background: index == root.current-tab ? #1e1e1e : (tab-area.has-hover ? #2d2d30 : transparent);
                                tab-area := TouchArea {
                                    clicked => { root.select-tab(index); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 4px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: tab.running ? #3fb950 : #5a5a5a;
                                    }
                                    Text {
                                        text: tab.name;
                                        color: index == root.current-tab ? white : #b0b0b0;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: 22px;
                                        Text {
                                            text: "×";
                                            color: close-area.has-hover ? white : #808080;
                                            font-size: 16px;
                                        }
                                        close-area := TouchArea {
                                            clicked => { root.close-tab(index); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // The current tab.
                    if root.current-tab < 0: Rectangle {
                        Text {
                            text: "Open a VM from the library, or make a new one.";
                            color: #808080;
                            font-size: 15px;
                        }
                    }
                    if root.current-tab >= 0: VerticalLayout {
                        // The VM's toolbar.
                        if !root.fullscreen: Rectangle {
                            height: 44px;
                            background: #2a2a2a;
                            HorizontalLayout {
                                padding: 7px;
                                spacing: 6px;
                                if !root.current.running: ToolButton {
                                    text: "▶ Start";
                                    primary: true;
                                    clicked => { root.start-vm(); }
                                }
                                if root.current.running: ToolButton {
                                    text: "Shut down";
                                    clicked => { root.power-button(); }
                                }
                                if root.current.running: ToolButton {
                                    text: "Power off";
                                    clicked => { root.stop-vm(); }
                                }
                                if root.current.running: ToolButton {
                                    text: "Reset";
                                    clicked => { root.reset-vm(); }
                                }
                                if root.current.running: ToolButton {
                                    text: "Ctrl+Alt+Del";
                                    clicked => { root.ctrl-alt-del(); }
                                }
                                if root.current.running && root.current.windows: ToolButton {
                                    text: "Install vmmc Tools";
                                    clicked => { root.install-tools(); }
                                }
                                if root.current.running: ToolButton {
                                    text: root.show-console ? "Summary" : "Console";
                                    clicked => { root.show-console = !root.show-console; }
                                }
                                if root.current.running && root.show-console: ToolButton {
                                    text: "Full screen";
                                    clicked => { root.toggle-fullscreen(); }
                                }
                                if root.current.running && root.show-console: CheckBox {
                                    text: "Fit guest to window";
                                    checked <=> root.fit-guest;
                                }
                                Rectangle { }
                                if root.current.running && root.show-console: Text {
                                    text: root.keyboard-captured ? "Keyboard: guest (Ctrl+Alt releases it)" : "Click the screen to type in the guest";
                                    color: root.keyboard-captured ? #e3b341 : #8a8a8a;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // The console.
                        if root.current.running && root.show-console: console-area := Rectangle {
                            background: black;
                            // Screen pixels per guest pixel, as the picture is scaled to fit.
                            property <float> scale: min(self.width / (root.frame-width * 1phx), self.height / (root.frame-height * 1phx));
                            init => { root.console-resized(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            changed width => { root.console-resized(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            changed height => { root.console-resized(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            changed absolute-position => { root.console-resized(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            if !root.console-live: Text {
                                text: "Connecting…";
                                color: #808080;
                            }
                            Image {
                                source: root.screen;
                                width: parent.width;
                                height: parent.height;
                                image-fit: contain;
                            }
                            touch := TouchArea {
                                mouse-cursor: root.cursor-hardware ? MouseCursor.none : MouseCursor.default;
                                moved => {
                                    root.pointer(self.mouse-x, self.mouse-y, console-area.width, console-area.height, root.left, root.right, root.middle, 0);
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.keyboard-captured = true;
                                        shortcuts.focus();
                                    }
                                    if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                                        if (event.button == PointerEventButton.left) {
                                            root.left = event.kind == PointerEventKind.down;
                                        }
                                        if (event.button == PointerEventButton.right) {
                                            root.right = event.kind == PointerEventKind.down;
                                        }
                                        if (event.button == PointerEventButton.middle) {
                                            root.middle = event.kind == PointerEventKind.down;
                                        }
                                    }
                                    root.pointer(self.mouse-x, self.mouse-y, console-area.width, console-area.height, root.left, root.right, root.middle, 0);
                                }
                                scroll-event(event) => {
                                    root.pointer(self.mouse-x, self.mouse-y, console-area.width, console-area.height, root.left, root.right, root.middle, event.delta-y > 0 ? 1 : -1);
                                    accept
                                }
                            }
                            Image {
                                source: root.cursor-image;
                                x: touch.mouse-x - root.cursor-hot-x * console-area.scale * 1phx;
                                y: touch.mouse-y - root.cursor-hot-y * console-area.scale * 1phx;
                                width: root.cursor-image.width * console-area.scale * 1phx;
                                height: root.cursor-image.height * console-area.scale * 1phx;
                                visible: root.cursor-hardware && root.cursor-shown && touch.has-hover;
                            }
                        }

                        // The summary.
                        if !root.current.running || !root.show-console: ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 14px;
                                alignment: start;
                                Text {
                                    text: root.current.name;
                                    font-size: 24px;
                                    font-weight: 700;
                                    color: white;
                                }
                                Text {
                                    text: root.current.os + (root.current.running ? " · running" : " · powered off");
                                    color: root.current.running ? #3fb950 : #9a9a9a;
                                }
                                if root.current.origin != "": Text {
                                    text: root.current.origin;
                                    color: #79c0ff;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: "Settings";
                                        enabled: !root.current.running;
                                        clicked => { root.open-settings(); }
                                    }
                                    Button {
                                        text: "Show files";
                                        clicked => { root.show-folder(); }
                                    }
                                    Button {
                                        text: "Remove from library";
                                        enabled: !root.current.running;
                                        clicked => { root.remove-vm(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "Library folder";
                                        color: #c8c8c8;
                                        vertical-alignment: center;
                                    }
                                    folder := LineEdit {
                                        width: 220px;
                                        text: root.current.folder;
                                        placeholder-text: "none";
                                    }
                                    Button {
                                        text: "Move";
                                        clicked => { root.move-to-folder(folder.text); }
                                    }
                                }
                                Text {
                                    text: "Hardware";
                                    font-weight: 700;
                                    color: white;
                                }
                                Text {
                                    text: root.current.details;
                                    color: #d0d0d0;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Created " + root.current.created + (root.current.started == "" ? "; never started" : "; last started " + root.current.started);
                                    color: #8a8a8a;
                                }
                                Text {
                                    text: "Notes";
                                    font-weight: 700;
                                    color: white;
                                }
                                notes := TextEdit {
                                    height: 140px;
                                    text: root.current.notes;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: "Save notes";
                                        clicked => { root.save-notes(notes.text); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // In full screen, a bar at the top: it shows on entering, and when the pointer
    // touches the top edge.
    if root.fullscreen && root.fullscreen-bar: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 46px;
        background: #202020e8;
        TouchArea { }
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            alignment: center;
            Button {
                text: "Exit full screen";
                primary: true;
                clicked => { root.toggle-fullscreen(); }
            }
            Button {
                text: "Ctrl+Alt+Del";
                clicked => { root.ctrl-alt-del(); }
            }
            Text {
                text: "Ctrl+Alt releases the keyboard; then Ctrl+Alt+Enter or Esc leaves full screen.";
                color: #c8c8c8;
                vertical-alignment: center;
            }
        }
    }

    // The New VM wizard.
    if root.wizard-open: Sheet {
        width: root.width;
        height: root.height;
        heading: "New VM";
        ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Field {
                    label: "Name";
                    LineEdit { text <=> root.wizard-name; }
                }
                Field {
                    label: "Operating system";
                    ComboBox {
                        model: root.os-labels;
                        current-index <=> root.wizard-os;
                        selected => { root.wizard-os-changed(self.current-index); }
                    }
                }
                Field {
                    label: "Install disc (ISO)";
                    LineEdit { text <=> root.wizard-iso; }
                    Button {
                        text: "Browse…";
                        clicked => { root.browse-iso(); }
                    }
                }
                Field {
                    label: "Easy Install";
                    CheckBox {
                        text: "Install the OS with no questions (Windows, Ubuntu)";
                        checked <=> root.wizard-easy;
                        enabled: root.wizard-os <= 2;
                    }
                }
                if root.wizard-easy && root.wizard-os <= 2: VerticalLayout {
                    spacing: 8px;
                    Field {
                        label: "User name";
                        LineEdit { text <=> root.wizard-user; }
                    }
                    Field {
                        label: "Password";
                        LineEdit {
                            text <=> root.wizard-password;
                            input-type: InputType.password;
                        }
                    }
                    if root.wizard-os <= 1: Field {
                        label: "Windows edition";
                        ComboBox {
                            model: root.editions;
                            current-index <=> root.wizard-edition;
                        }
                    }
                }
                Field {
                    label: "Processors";
                    SpinBox {
                        minimum: 1;
                        maximum: 32;
                        value <=> root.wizard-cpus;
                    }
                }
                Field {
                    label: "Memory (GiB)";
                    SpinBox {
                        minimum: 1;
                        maximum: 256;
                        value <=> root.wizard-memory-gib;
                    }
                }
                Field {
                    label: "Disk (GiB)";
                    SpinBox {
                        minimum: 1;
                        maximum: 16384;
                        value <=> root.wizard-disk-gib;
                    }
                }
                Field {
                    label: "Folder";
                    LineEdit { text <=> root.wizard-folder; }
                    Button {
                        text: "Browse…";
                        clicked => { root.browse-folder(); }
                    }
                }
                if root.wizard-error != "": Text {
                    text: root.wizard-error;
                    color: #f85149;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel";
                clicked => { root.wizard-open = false; }
            }
            Button {
                text: "Create";
                primary: true;
                clicked => { root.create-vm(); }
            }
        }
    }

    // The current VM's settings.
    if root.settings-open: Sheet {
        width: root.width;
        height: root.height;
        heading: "Settings: " + root.current.name;
        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Field {
                label: "Processors";
                SpinBox {
                    minimum: 1;
                    maximum: 64;
                    value <=> root.settings-cpus;
                }
            }
            Field {
                label: "Memory (MiB)";
                SpinBox {
                    minimum: 32;
                    maximum: 1048576;
                    value <=> root.settings-memory-mib;
                }
            }
            Field {
                label: "DVD drive (ISO)";
                LineEdit {
                    text <=> root.settings-cdrom;
                    placeholder-text: "empty";
                }
                Button {
                    text: "Browse…";
                    clicked => { root.browse-cdrom(); }
                }
            }
            Field {
                label: "Resolution";
                LineEdit {
                    text <=> root.settings-resolution;
                    placeholder-text: "automatic, or like 1920x1080";
                }
            }
            Field {
                label: "Firmware";
                CheckBox {
                    text: "Secure Boot";
                    checked <=> root.settings-secure-boot;
                }
                CheckBox {
                    text: "TPM 2.0";
                    checked <=> root.settings-tpm;
                }
            }
            Field {
                label: "Hyper-V enlightenments";
                CheckBox {
                    text: "On (faster Windows and Linux guests)";
                    checked <=> root.settings-enlightenments;
                }
            }
            Text {
                text: "Changing Secure Boot gives the VM a fresh UEFI variable store (the old one is kept as nvram.fd.old).";
                color: #8a8a8a;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.settings-error != "": Text {
                text: root.settings-error;
                color: #f85149;
                wrap: word-wrap;
            }
        }
        Rectangle { }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel";
                clicked => { root.settings-open = false; }
            }
            Button {
                text: "Save";
                primary: true;
                clicked => { root.save-settings(); }
            }
        }
    }

    // A message.
    if root.message-open: Sheet {
        width: root.width;
        height: root.height;
        heading: root.message-title;
        ScrollView {
            Text {
                text: root.message-text;
                color: #d0d0d0;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "OK";
                primary: true;
                clicked => { root.message-open = false; }
            }
        }
    }

    about := PopupWindow {
        x: 40px;
        y: 50px;
        width: 380px;
        Rectangle {
            background: #303030;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "vmmc: a desktop hypervisor, Apache-2.0.\nVMware is a trademark of Broadcom Inc.; vmmc isn't affiliated with Broadcom.";
                    wrap: word-wrap;
                    color: white;
                }
                AboutSlint { }
            }
        }
    }
}

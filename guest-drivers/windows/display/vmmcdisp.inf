;
; vmmc display driver: resolutions and mode changes for vmmc's display adapter, and
; its helper, which keeps the desktop the size of the host's window.
;

[Version]
Signature = "$Windows NT$"
Class = Display
ClassGUID = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider = %Vmmc%
DriverVer =
CatalogFile = vmmcdisp.cat
PnpLockdown = 1

[DestinationDirs]
VmmcDisplay.Files = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
vmmcdisp.sys = 1
vmmcdisplay.exe = 1

; Windows 10 1709 and later: the files stay in the driver store (directory 13).
[Manufacturer]
%Vmmc% = Vmmc, NTamd64.10.0...16299

[Vmmc.NTamd64.10.0...16299]
%DeviceName% = VmmcDisplay, PCI\VEN_1234&DEV_1111

[VmmcDisplay]
FeatureScore = F9
CopyFiles = VmmcDisplay.Files

[VmmcDisplay.Files]
vmmcdisp.sys
vmmcdisplay.exe

[VmmcDisplay.Services]
AddService = vmmcdisp, 0x00000002, VmmcDisplay.Service
; The helper's service, started now (0x800) and at every boot. It starts the helper in
; each user's session.
AddService = vmmcdisplay, 0x00000800, VmmcHelper.Service

[VmmcDisplay.Service]
DisplayName = %DeviceName%
ServiceType = 1 ; kernel driver
StartType = 3 ; on demand
ErrorControl = 1 ; normal
ServiceBinary = %13%\vmmcdisp.sys

[VmmcHelper.Service]
DisplayName = %HelperName%
Description = %HelperDescription%
ServiceType = 0x10 ; a program of its own
StartType = 2 ; at boot
ErrorControl = 1 ; normal
ServiceBinary = %13%\vmmcdisplay.exe

[Strings]
Vmmc = "vmmc"
DiskName = "vmmc display driver"
DeviceName = "vmmc Display Adapter"
HelperName = "vmmc Display Helper"
HelperDescription = "Keeps the desktop the size of vmmc's window."
